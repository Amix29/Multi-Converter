* text=auto

*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
branding-kit/08_design-system/** text eol=lf
src-tauri/ocr-resources/licenses/*.txt text eol=lf
tools/ocr-runtime/*.lock.txt text eol=lf
# Keep checksum-pinned native source/license inputs stable on Windows checkouts.
tools/ocr-runtime/native-worker/** text=auto eol=lf
vendor/oar-ocr/** text=auto eol=lf
vendor/oar-ocr-core/** text=auto eol=lf
# Generated overlays preserve upstream whitespace and pinned byte hashes.
tools/engine-profiles/**/*.xcu text eol=lf -whitespace
*.nsh text eol=crlf

*.png binary
tests/fixtures/formats/sample.* -text
tests/fixtures/formats/sample.rtf whitespace=trailing-space,cr-at-eol
tests/fixtures/formats/animated.gif -text
*.ico binary
*.icns binary
*.bmp binary
*.exe binary
src-tauri/binaries/*.exe filter=lfs diff=lfs merge=lfs -text
*.zip binary
