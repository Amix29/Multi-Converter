{
  "name": "multi-converter",
  "version": "1.0.6",
  "description": "Local desktop file converter for documents, images, audio and video.",
  "homepage": "https://github.com/Amix29/Multi-Converter#readme",
  "bugs": {
    "url": "https://github.com/Amix29/Multi-Converter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amix29/Multi-Converter.git"
  },
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "npm run tauri:dev",
    "dev": "vite",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:check": "npm --prefix site run check",
    "build:frontend": "npm run validate:i18n && npm run typecheck && vite build",
    "build:frontend:preview": "npm run validate:i18n && npm run typecheck && vite build --mode preview",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run prepare:installer-assets && npm run prepare:bundled-engines && npm run validate:bundled-engines && npm run validate:embedded-manifest && npm run validate:i18n && tsc --noEmit && vite build",
    "check": "npm run prepare:installer-assets && npm run validate:bundled-engines && npm run validate:embedded-manifest && npm run validate:i18n && npm run test:release-notes && npm run test:editor && npm run test:ocr && npm run typecheck:tests && npm run test:unit && npm run test:elf && npm run test:macos-packaging && npm run test:linux-packaging && npm run test:linux-sidecars && npm run test:linux-sidecar-release-assets && npm run test:linux-engine-release-assets && npm run test:github-workflows && npm run test:release-assets && npm run test:macos-dmg-artifact && npm run test:macos-release-artifacts && npm run test:linux-release-artifacts && npm run test:bundled-engines-platform && npm run test:ui-layout && npm run test:repository-metadata && npm run test:production-config && npm run test:secret-leaks && npm run test:v1.0.6-status && npm run test:run-tauri && npm run typecheck && npm run validate:engines",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "sync:i18n": "node scripts/sync-i18n.mjs",
    "test:release-notes": "node --experimental-strip-types scripts/test-release-notes.ts",
    "test:editor": "node --experimental-strip-types scripts/test-editor.ts",
    "test:ocr": "node scripts/test-ocr.mjs && node scripts/pdfium-wrapper-cargo.mjs test",
    "test:ocr:runtime": "node scripts/test-ocr-runtime.mjs",
    "test:ocr:corpus": "node scripts/test-ocr-corpus.mjs",
    "test:unit": "vitest run",
    "test:ui:preview": "npm run build:frontend:preview && playwright test",
    "test:guardrails": "npm run typecheck:tests && npm run test:unit && npm run test:ui:preview",
    "measure:baseline": "node scripts/measure-refactor-baseline.mjs",
    "measure:windows-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-windows-runtime.ps1",
    "test:elf": "node scripts/test-elf.mjs",
    "test:macos-packaging": "node scripts/test-macos-packaging.mjs",
    "test:linux-packaging": "node scripts/test-linux-packaging.mjs",
    "test:linux-sidecars": "node scripts/test-linux-sidecars.mjs",
    "test:linux-sidecar-release-assets": "node scripts/test-linux-sidecar-release-assets.mjs",
    "test:linux-engine-release-assets": "node scripts/test-linux-engine-release-assets.mjs",
    "test:github-workflows": "node scripts/test-github-workflows.mjs",
    "test:release-assets": "node scripts/test-release-assets.mjs",
    "test:macos-dmg-artifact": "node scripts/test-macos-dmg-artifact.mjs",
    "test:macos-release-artifacts": "node scripts/test-macos-release-artifacts.mjs",
    "test:linux-release-artifacts": "node scripts/test-linux-release-artifacts.mjs",
    "test:bundled-engines-platform": "node scripts/test-bundled-engines-platform.mjs",
    "test:ui-layout": "node scripts/test-ui-layout.mjs",
    "test:repository-metadata": "node scripts/test-repository-metadata.mjs",
    "test:production-config": "node scripts/test-production-config.mjs",
    "test:secret-leaks": "node scripts/test-secret-leaks.mjs",
    "validate:release-notes-body": "node scripts/validate-release-notes.mjs",
    "status:v1.0.5": "node scripts/report-v1-0-5-status.mjs",
    "test:v1.0.5-status": "node scripts/test-v1-0-5-status.mjs",
    "status:v1.0.6": "node scripts/report-v1-0-6-status.mjs",
    "test:v1.0.6-status": "node scripts/test-v1-0-6-status.mjs",
    "test:run-tauri": "node scripts/test-run-tauri.mjs",
    "test:windows:ci": "node scripts/test-windows-ci-gate.mjs",
    "test:macos:host": "node scripts/test-macos-host.mjs",
    "test:macos:conversions": "node scripts/test-macos-conversions.mjs",
    "test:linux:environment": "node scripts/test-linux-environment.mjs",
    "test:linux:ci": "node scripts/test-linux-ci-gate.mjs",
    "test:linux:host": "node scripts/test-linux-host.mjs",
    "test:linux:conversions": "node scripts/test-linux-conversions.mjs",
    "tauri": "tauri",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "tauri:build:macos": "node scripts/run-tauri.mjs build --target universal-apple-darwin --bundles app,dmg --config src-tauri/tauri.macos.conf.json",
    "tauri:build:linux": "node scripts/run-tauri.mjs build --target x86_64-unknown-linux-gnu --bundles appimage --config src-tauri/tauri.linux.conf.json",
    "package:engines": "node scripts/package-engines.mjs",
    "package:macos-engines": "node scripts/package-engines.mjs --config tools/engine-packages.macos.config.json --output dist-engines-macos",
    "package:linux-engines": "node scripts/package-engines.mjs --config tools/engine-packages.linux.config.json --output dist-engines-linux",
    "prepare:macos-engine-release-assets": "node scripts/prepare-macos-engine-release-assets.mjs",
    "prepare:linux-engine-sources": "node scripts/prepare-linux-engine-sources.mjs",
    "prepare:linux-engine-release-assets": "node scripts/prepare-linux-engine-release-assets.mjs",
    "prepare:linux-sidecar-release-assets": "node scripts/prepare-linux-sidecar-release-assets.mjs",
    "prepare:macos-local-engines": "node scripts/prepare-macos-local-engines.mjs",
    "prepare:macos-dmg-artifact": "node scripts/prepare-macos-dmg-artifact.mjs",
    "prepare:macos-release-artifacts": "node scripts/prepare-macos-release-artifacts.mjs",
    "prepare:linux-sidecars": "node scripts/prepare-linux-sidecars.mjs",
    "prepare:linux-release-artifacts": "node scripts/prepare-linux-release-artifacts.mjs",
    "prepare:release-assets": "node scripts/prepare-release-assets.mjs",
    "prepare:base-engines": "node scripts/prepare-base-engines.mjs",
    "prepare:bundled-engines": "node scripts/prepare-bundled-engines.mjs",
    "prepare:ocr-models": "node scripts/prepare-ocr-models.mjs",
    "prepare:ocr-runtime": "node scripts/prepare-ocr-runtime.mjs",
    "build:ocr-runtime:windows": "node scripts/build-ocr-reference-runtime.mjs --platform windows-x64",
    "prepare:installer-assets": "node scripts/generate-installer-assets.mjs",
    "package:base-engines": "node scripts/package-base-engines.mjs",
    "audit:rust": "cargo audit --file src-tauri/Cargo.lock",
    "prepare:ffmpeg-engine:macos": "node scripts/prepare-ffmpeg-engine-macos.mjs",
    "prepare:pdfium-engine": "node scripts/prepare-pdfium-engine.mjs",
    "prepare:pdfium-engine:macos": "node scripts/prepare-pdfium-engine-macos.mjs",
    "prepare:pdfium-engine:linux": "node scripts/prepare-pdfium-engine-linux.mjs",
    "package:pdfium-engine": "node scripts/package-pdfium-engine.mjs",
    "prepare:libreoffice-engine": "node scripts/prepare-libreoffice-engine.mjs",
    "prepare:libreoffice-engine:macos": "node scripts/prepare-libreoffice-engine-macos.mjs",
    "prepare:libreoffice-engine:linux": "node scripts/prepare-libreoffice-engine-linux.mjs",
    "package:libreoffice-engine": "node scripts/package-libreoffice-engine.mjs",
    "prepare:pandoc-engine": "node scripts/prepare-pandoc-engine.mjs",
    "prepare:pandoc-engine:macos": "node scripts/prepare-pandoc-engine-macos.mjs",
    "prepare:pandoc-engine:linux": "node scripts/prepare-pandoc-engine-linux.mjs",
    "prepare:macos-upstream-engines": "npm run prepare:pdfium-engine:macos && npm run prepare:libreoffice-engine:macos && npm run prepare:pandoc-engine:macos",
    "prepare:linux-upstream-engines": "npm run prepare:pdfium-engine:linux && npm run prepare:libreoffice-engine:linux && npm run prepare:pandoc-engine:linux && npm run prepare:libvips-engine:linux",
    "package:pandoc-engine": "node scripts/package-pandoc-engine.mjs",
    "prepare:libvips-engine": "node scripts/prepare-libvips-engine.mjs",
    "prepare:libvips-engine:macos": "node scripts/prepare-libvips-engine-macos.mjs",
    "prepare:libvips-engine:linux": "node scripts/prepare-libvips-engine-linux.mjs",
    "build:libvips-macos-runtime": "node scripts/build-libvips-macos-runtime.mjs",
    "prepare:libvips-macos-release-inputs": "node scripts/prepare-libvips-macos-release-inputs.mjs",
    "package:libvips-engine": "node scripts/package-libvips-engine.mjs",
    "validate:engines": "node scripts/package-engines.mjs --validate",
    "validate:bundled-engines": "node scripts/validate-bundled-engines.mjs",
    "validate:embedded-manifest": "node scripts/validate-embedded-manifest.mjs",
    "validate:release-assets": "node scripts/validate-release-assets.mjs",
    "verify:macos-dmg": "node scripts/verify-macos-dmg.mjs",
    "verify:linux-appimage": "node scripts/verify-linux-appimage.mjs",
    "fmt:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "clippy:rust": "node scripts/cargo-test-temp.mjs clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "npm run test:rust && npm run test:conversions",
    "test:rust": "node scripts/cargo-test-temp.mjs test --manifest-path src-tauri/Cargo.toml",
    "test:bundled-engine-archive": "node scripts/cargo-test-temp.mjs test --manifest-path src-tauri/Cargo.toml engine_archive::tests::prepared_libreoffice_archive_extracts_required_launcher -- --ignored --nocapture",
    "test:conversions": "node scripts/cargo-test-temp.mjs test --manifest-path src-tauri/Cargo.toml conversion_matrix -- --ignored --nocapture",
    "test:pdf": "node scripts/cargo-test-temp.mjs test --manifest-path src-tauri/Cargo.toml pdf_text_conversions -- --nocapture",
    "test:pdfium-wrapper": "node scripts/pdfium-wrapper-cargo.mjs test",
    "test:pdfium-wrapper:compile": "node scripts/pdfium-wrapper-cargo.mjs test --no-run",
    "clippy:pdfium-wrapper": "node scripts/pdfium-wrapper-cargo.mjs clippy --all-targets -- -D warnings"
  },
  "keywords": [
