# URL finale publique du site, sans slash final.
# Exemple pour l'URL finale GitHub Pages :
# NEXT_PUBLIC_SITE_URL=https://amix29.github.io/Multi-Converter
NEXT_PUBLIC_SITE_URL=https://amix29.github.io/Multi-Converter

# Chemin de base uniquement pour un dépôt GitHub Pages de projet.
# Exemple : /Multi-Converter
# Laisser vide pour un domaine custom ou utilisateur.github.io.
NEXT_PUBLIC_BASE_PATH=/Multi-Converter

# Version affichée dans la section téléchargement.
NEXT_PUBLIC_PRODUCT_VERSION=v1.0.0

# Dépôt source public et pages associées.
NEXT_PUBLIC_SOURCE_URL=https://github.com/Amix29/Multi-Converter
NEXT_PUBLIC_RELEASES_URL=https://github.com/Amix29/Multi-Converter/releases/latest
NEXT_PUBLIC_LATEST_RELEASE_API_URL=https://api.github.com/repos/Amix29/Multi-Converter/releases/latest
NEXT_PUBLIC_ISSUES_URL=https://github.com/Amix29/Multi-Converter/issues

# Vérification des moteurs de recherche.
# Coller ici les jetons fournis par Google Search Console, Bing Webmaster Tools ou Yandex.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
