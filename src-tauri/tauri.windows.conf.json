{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "resources": {
      "bundled-engines/pdfium/": "engines/pdfium/",
      "bundled-engines/pandoc/": "engines/pandoc/",
      "bundled-engines/libvips/": "engines/libvips/",
      "bundled-engine-profiles/windows-x64/v3/libreoffice/": "engines/libreoffice/compatible/",
      "bundled-engine-profiles/windows-x64/v3/ocr/": "ocr/",
      "ocr-resources/licenses/": "ocr/licenses/",
      "ocr-resources/README.md": "ocr/README.md"
    },
    "windows": {
      "nsis": {
        "compression": "lzma"
      }
    }
  },
  "build": {
    "beforeBundleCommand": "node scripts/prepare-windows-resources.mjs --check"
  }
}
